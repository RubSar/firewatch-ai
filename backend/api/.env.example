# Load these variables into the server process. No dotenv loader is used.
FIREWATCH_EE_PROJECT=
# Use Earth Engine user auth for development or Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/credentials.json
FIREWATCH_EE_TIMEOUT_SECONDS=120
# Optional bearer token; required by your deployment before exposing beyond localhost.
FIREWATCH_API_TOKEN=
# Optional explicit origins, comma separated. Default: no cross-origin access.
FIREWATCH_CORS_ORIGINS=
