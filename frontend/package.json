{
  "name": "firewatch-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "sim",
    "contracts",
    "api"
  ],
  "scripts": {
    "dev": "(trap 'kill 0' INT TERM EXIT; npm run dev:api & VITE_API_URL=http://127.0.0.1:8787 npm run dev:web; wait)",
    "dev:web": "vite",
    "dev:api": "npm run dev --workspace=@firewatch/api",
    "build": "npm run build:web && npm run build --workspaces --if-present",
    "typecheck": "tsc -b && npm run typecheck --workspaces --if-present",
    "smoke": "node scripts/smoke.mjs",
    "smoke:api": "npm run smoke --workspace=@firewatch/api",
    "watercheck": "npm run watercheck --workspace=@firewatch/api",
    "scarcheck": "npm run scarcheck --workspace=@firewatch/api",
    "test": "npm run test:web && npm run test --workspaces --if-present",
    "bench": "npm run bench --workspace=@firewatch/sim",
    "hindcast": "npm run hindcast --workspace=@firewatch/api",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview",
    "calibrate": "node scripts/calibrate.mjs",
    "test:web": "node --test scripts/history.test.mjs",
    "smoke:history": "node scripts/history-smoke.mjs"
  },
  "dependencies": {
    "@firewatch/contracts": "*",
    "@firewatch/sim": "*",
    "d3-contour": "^4.0.2",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3-contour": "^3.0.6",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
